{
  "name": "vue-expert-datatable",
  "version": "0.2.87",
  "type": "module",
  "description": "Vue component which automates the working with tables, allowing to use in-line editing and API REST based adding, editing and deleting records",
  "main": "dist/vue-expert-datatable.ssr.js",
  "browser": "dist/vue-expert-datatable.esm.js",
  "module": "dist/vue-expert-datatable.esm.js",
  "unpkg": "dist/vue-expert-datatable.min.js",
  "types": "vue-expert-datatable.d.ts",
  "files": [
    "dist/*",
    "vue-expert-datatable.d.ts",
    "src/**/*.vue"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "start": "yarm run dev",
    "serve": "yarm run dev",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "npx eslint --ext .js,.ts,.vue src/",
    "lint:fix": "npx eslint --ext .js,.ts,.vue src/ --fix",
    "format": "prettier --write \"src/**/*.{js,ts,vue,scss,css,html}\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Arturokin/vue-expert-datatable"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-regular-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/vue-fontawesome": "^3.0.8",
    "@vee-validate/i18n": "^4.15.1",
    "@vee-validate/rules": "^4.15.1",
    "@vee-validate/zod": "^4.15.1",
    "@vuepic/vue-datepicker": "^11.0.2",
    "autonumeric": "^4.10.8",
    "axios": "^1.10.0",
    "core-js": "^3.43.0",
    "dayjs": "^1.11.13",
    "floating-vue": "^5.2.2",
    "just-clone": "^6.2.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.16",
    "vue-autonumeric": "^1.2.6",
    "vue-component-type-helpers": "^2.2.10",
    "vue-tippy": "v6",
    "vue3-datepicker": "^0.4.0",
    "zod": "^3.25.65"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@types/node": "^24.0.1",
    "@typescript-eslint/eslint-plugin": "^8.34.0",
    "@typescript-eslint/parser": "^8.34.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/eslint-config-typescript": "^14.5.0",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-define-config": "^2.1.0",
    "eslint-plugin-prettier": "^5.4.1",
    "eslint-plugin-vue": "^10.2.0",
    "globals": "^16.2.0",
    "path": "^0.12.7",
    "prettier": "^3.5.3",
    "sass": "^1.89.2",
    "sass-loader": "^16.0.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.34.0",
    "vite": "^6.3.5",
    "vue-eslint-parser": "^10.1.3",
    "vue-tsc": "^2.2.8"
  },
  "peerDependencies": {
    "vue": "^2.6.12"
  },
  "engines": {
    "node": ">=12"
  }
}
